# general workload settings
# Số lượng bản ghi dữ liệu khách hàng được sinh ra
DEFAULT_NUM_RECORDS=5
# Hạt giống ngẫu nhiên cố định để kết quả tái lập được 100%
DEFAULT_SEED=42
# Tỷ lệ phần trăm giao dịch chéo đọc ghi giữa các cụm máy chủ khác nhau
DEFAULT_CROSS_TX_RATIO=0.08
# Số lượng máy chủ phân tán đích cần chia
DEFAULT_SITE_NUM=2

# algorithm 2 dynamic partitioning settings

# Hệ số lệch tải alpha cho phép giữa các máy chủ so với mức trung bình
ALGO2_WORKLOAD_FACTOR=0.2
# Ngưỡng tỷ lệ vết cắt phân tán theta để kích hoạt tối ưu cạnh cắt (Algorithm 4)
ALGO2_DISTRIBUTED_PERCENTAGE=0.02
# Giới hạn số vòng lặp đệ quy tối đa để tránh lặp vô hạn
ALGO2_RECURSION_DEPTH=10
# Tùy chọn sử dụng BPG (True) hoặc Algorithm 5 tham lam (False) khi cần khởi tạo lại
ALGO2_USE_BPG=True

# bpg solver hyperparameters
# Số vòng lặp cập nhật gradient và phép chiếu Bregman tối đa
BPG_MAX_ITER=100
# Ngưỡng dung sai dừng sớm khi ma trận xác suất hội tụ
BPG_TOL=1e-4
# Số lần khởi động lại từ các điểm ngẫu nhiên để chống kẹt ở cực tiểu địa phương
BPG_NUM_RESTARTS=3
# Hệ số tỷ lệ beta tự động co giãn bước học gradient theo thể tích đồ thị
BPG_STEP_SCALE=0.06

# benchmark settings
# Danh sách quy mô đối đầu theo cú pháp records:txs:clusters:sites
BENCHMARK_SCALES=10:30:2:2,20:60:2:2,50:150:2:2,100:300:4:4,200:600:4:4
BENCHMARK_OUTPUT_PATH=docs/benchmark_results.md
