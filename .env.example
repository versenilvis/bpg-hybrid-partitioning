# general workload settings
DEFAULT_NUM_RECORDS=5
DEFAULT_SEED=42
DEFAULT_CROSS_TX_RATIO=0.08
DEFAULT_SITE_NUM=2

# algorithm 2 dynamic partitioning settings
ALGO2_WORKLOAD_FACTOR=0.2
ALGO2_DISTRIBUTED_PERCENTAGE=0.02
ALGO2_RECURSION_DEPTH=10
ALGO2_USE_BPG=True

# bpg solver hyperparameters
BPG_MAX_ITER=100
BPG_TOL=1e-4
BPG_NUM_RESTARTS=3
BPG_STEP_SCALE=0.06

# benchmark settings
BENCHMARK_SCALES=10:30:2:2,20:60:2:2,50:150:2:2,100:300:4:4,200:600:4:4
BENCHMARK_OUTPUT_PATH=docs/benchmark_results.md
